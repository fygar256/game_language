#!/usr/bin/env miep
10#==== ASTERISKS (ast.py の GAME 言語版) ====
11#  ブロックを押して敵(＊)を全部閉じ込めるゲーム
12#  キーは /dev/input/eventN から &キーコード で読む (押されていれば 1)
13#  7 8 9 / u o (4 6) / j k l (1 2 3) と矢印キーで8方向に移動  q 終了
14#  N 敵の数 (-e)  B ブロックの数 (-b)  R 1 なら白黒反転 (-r)
15#  S 画面バッファ(40x24) S:y*40+x)  0 空白 1 プレイヤー 2 ブロック 3 壁 4 敵
16#  Z 敵の位置 Z(i*2)=x Z(i*2+1)=y  T キー表 T(i*3)=キーコード T(i*3+1)=dx T(i*3+2)=dy
17#  X,Y プレイヤーの位置  D,E 移動方向  F コマ数 (0〜3)  K,J 通常/反転の表示属性
18#  O キーを押し続けたときのリピート用 (0 のコマで動く。1コマ 0.1 秒なので 0.2 秒ごと)
100 S=$4000 Z=$5000 T=$5100
110 N=5 B=400 R=1
120 K=0 J=7 ;=R K=7 J=0
130 !=1500
140 $=27 "]0;Asterisks" $=7 $=27 "[?1049h" $=27 "[?25l"
150 !=1000
160 #=2000
1000#==== init_screen ====
1010 I=0,959 S:I)=0 @=I+1
1020 $=27 "[0m" $=27 "[2J"
1030 ;=R $=27 "[7m" M=1,25 $=27 "[" ?=M ";1H" .=80 @=M+1
1040 A=3 L=0,39 M=0 !=8000 M=22 !=8000 @=L+1
1050 M=0,21 L=0 !=8000 L=39 !=8000 @=M+1
1060 ;=B>0 A=2 I=1,B L='38+1 M='21+1 !=8000 @=I+1
1070 X=20 Y=12 L=X M=Y A=1 !=8000
1080 ;=N=0 ]
1090 I=0,N-1
1100   @
1110     P='38+1 Q='21+1
1120   @=(S:Q*40+P)=0)
1130   Z(I*2)=P Z(I*2+1)=Q L=P M=Q A=4 !=8000
1140 @=I+1 ]
1500#==== キー表 (キーコード, dx, dy) ====
1510 T(0)=8 T(1)=-1 T(2)=-1 T(3)=71 T(4)=-1 T(5)=-1
1520 T(6)=9 T(7)=0 T(8)=-1 T(9)=72 T(10)=0 T(11)=-1 T(12)=103 T(13)=0 T(14)=-1
1530 T(15)=10 T(16)=1 T(17)=-1 T(18)=73 T(19)=1 T(20)=-1
1540 T(21)=22 T(22)=-1 T(23)=0 T(24)=5 T(25)=-1 T(26)=0 T(27)=75 T(28)=-1 T(29)=0 T(30)=105 T(31)=-1 T(32)=0
1550 T(33)=24 T(34)=1 T(35)=0 T(36)=7 T(37)=1 T(38)=0 T(39)=77 T(40)=1 T(41)=0 T(42)=106 T(43)=1 T(44)=0
1560 T(45)=36 T(46)=-1 T(47)=1 T(48)=2 T(49)=-1 T(50)=1 T(51)=79 T(52)=-1 T(53)=1
1570 T(54)=37 T(55)=0 T(56)=1 T(57)=3 T(58)=0 T(59)=1 T(60)=80 T(61)=0 T(62)=1 T(63)=108 T(64)=0 T(65)=1
1580 T(66)=38 T(67)=1 T(68)=1 T(69)=4 T(70)=1 T(71)=1 T(72)=81 T(73)=1 T(74)=1 ]
2000#==== mainloop ====
2010 F=0 O=0
2020 ;=&16 #=9900
2030 !=3000 ;=H=0 O=0
2032 ;=H ;=O=0 !=3100
2034 ;=H O=O+1 ;=O>=2 O=0
2040 ;=F=0 !=4000
2050 !=5000 ;=G $=27 "[1;1H" $=27 "[" ?=K "m" "You Lose!! Game Over." #=2100
2060 !=5100 ;=W $=27 "[1;1H" $=27 "[" ?=K "m" "You Win!! Game Over." #=2100
2070 *WT 100
2080 F=F+1 ;=F>=4 F=0
2090 #=2020
2100#==== ゲームオーバー: q を待つ ====
2110 @
2120   *WT 50
2130 @=(&16)
2140 #=9900
3000#==== getkey: 押されているキーの方向を D,E に (あれば H=1) ====
3010 H=0 I=0
3020 @
3030   ;=&T(I*3) H=1 D=T(I*3+1) E=T(I*3+2)
3040   I=I+1
3050 @=(H+(I>=25))
3060 ]
3100#==== Player.move ====
3110 P=X+D Q=Y+E C=S:Q*40+P)
3120 ;=C=2 !=3200
3130 ;=C<>0 ]
3140 L=X M=Y A=0 !=8000 X=P Y=Q L=X M=Y A=1 !=8000 ]
3200#==== _push_blocks: 続くブロックの先が空白なら置いて C=0、だめなら C=3 ====
3210 U=P V=Q
3220 @
3230   U=U+D V=V+E C=S:V*40+U)
3240 @=(C<>2)
3250 ;=C=0 L=U M=V A=2 !=8000 ]
3260 C=3 ]
4000#==== Enemy.move (全部の敵) ====
4010 ;=N=0 ]
4020 I=0,N-1
4030   P=Z(I*2)+'3-1 Q=Z(I*2+1)+'3-1 C=S:Q*40+P)
4040   ;=(C=0)+(C=1) L=Z(I*2) M=Z(I*2+1) A=0 !=8000 Z(I*2)=P Z(I*2+1)=Q L=P M=Q A=4 !=8000
4050 @=I+1 ]
5000#==== check_lose: プレイヤーと敵が重なったら G=1 ====
5010 G=0 ;=N=0 ]
5020 I=0,N-1
5030   ;=(Z(I*2)=X)*(Z(I*2+1)=Y) G=1
5040 @=I+1 ]
5100#==== check_win: どの敵の周り8マスにも空白がなければ W=1 ====
5110 W=1 ;=N=0 ]
5120 I=0,N-1
5130   P=Z(I*2) Q=Z(I*2+1)
5140   U=-1,1
5150     V=-1,1
5160       ;=S:Q+V*40+P+U)=0 W=0
5170     @=V+1
5180   @=U+1
5190 @=I+1 ]
8000#==== put: (L,M) に A を描く (1マス=2桁) ====
8010 S:M*40+L)=A $=27 "[" ?=M+1 ";" ?=L*2+1 "H" $=27 "["
8020 ;=(A=2)+(A=3) ?=J #=8040
8030 ?=K
8040 "m"
8050 ;=A=0 "　" ]
8060 ;=A=1 "Ｏ" ]
8070 ;=A=2 "Ｂ" ]
8080 ;=A=3 "＃" ]
8090 "＊" ]
9900#==== 終了 ====
9910 $=27 "[0m" $=27 "[2J" $=27 "[H" $=27 "[?25h" $=27 "[?1049l"
9920 *QU
