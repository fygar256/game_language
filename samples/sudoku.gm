#!/usr/bin/env miep
1'=== 数独エディタ＆ソルバ (sudoku.py の GAME 言語移植版) ===
2'memory: grid=0-80 temp=100-180 empty=300-380 rowuse=400-499 coluse=500-599
3'        boxuse=600-699 emptyrow=700-780 emptycol=800-880 emptybox=900-980 line=1000-1249
10 #=1000
90'--- solve_sudoku(temp) -> Z 1:solved 0:fail ---
100 I=0,80 M:I+100)=M:I) @=I+1
102 I=0,299 M:I+400)=0 @=I+1
104 N=0 P=0,80 V=M:P+100) !=130 @=P+1
106 K=0
110 ;=K=N Z=1 ]
112 ;=K<0 Z=0 ]
114 P=M:K+300) R=M:K+700) C=M:K+800) B=M:K+900) V=M:P+100) ;=V !=150
116 @ V=V+1 @=((V>9)+(M:R*10+V+400)+M:C*10+V+500)+M:B*10+V+600)=0))
118 ;=V>9 M:P+100)=0 K=K-1 #=110
120 M:P+100)=V !=160 K=K+1 #=110
129'--- register cell P (value V) ---
130 R=P/9 C=%0 B=R/3*3+(C/3)
132 ;=V !=160 ]
134 M:N+300)=P M:N+700)=R M:N+800)=C M:N+900)=B N=N+1 ]
149'--- remove / add V at (R,C,B) ---
150 M:R*10+V+400)=M:R*10+V+400)-1 M:C*10+V+500)=M:C*10+V+500)-1 M:B*10+V+600)=M:B*10+V+600)-1 ]
160 M:R*10+V+400)=M:R*10+V+400)+1 M:C*10+V+500)=M:C*10+V+500)+1 M:B*10+V+600)=M:B*10+V+600)+1 ]
290'--- print_grid(G=base address) ---
300 "+-------+-------+-------+" /
310 R=0,8 "| " C=0,8 V=M:R*9+C+G) !=320 @=C+1 / !=330 @=R+1 ]
320 ;=V=0 "."
322 ;=V ?=V
324 " " ;=(C=2)+(C=5)+(C=8) "| "
326 ]
330 ;=(R=2)+(R=5)+(R=8) "+-------+-------+-------+" /
332 ]
390'--- input line -> buffer 1000.., length L, E=1:EOF (strip, lower) ---
400 L=0 E=0
410 C=$ ;=C<1 E=1 #=430
412 ;=C=10 #=430
414 ;=C=13 #=410
416 ;=(C>=65)*(C<=90) C=C+32
418 ;=L<250 M:1000+L)=C L=L+1
420 #=410
430 ;=L=0 #=440
432 C=M:999+L) ;=(C=32)+(C=9) L=L-1 #=430
440 S=0
442 ;=S>=L #=450
444 C=M:1000+S) ;=(C=32)+(C=9) S=S+1 #=442
450 ;=S=0 ]
452 L=L-S U=0,L-1 M:1000+U)=M:1000+S+U) @=U+1 ]
490'--- sample grid ---
500 R=0 A=530 B=70 C=0 !=550
502 R=1 A=600 B=195 C=0 !=550
504 R=2 A=98 B=0 C=60 !=550
506 R=3 A=800 B=60 C=3 !=550
508 R=4 A=400 B=803 C=1 !=550
510 R=5 A=700 B=20 C=6 !=550
512 R=6 A=60 B=0 C=280 !=550
514 R=7 A=0 B=419 C=5 !=550
516 R=8 A=0 B=80 C=79 !=550
518 ]
550 P=R*9 X=A !=560 P=P+3 X=B !=560 P=P+3 X=C !=560 ]
560 M:P)=X/100 X=%0 M:P+1)=X/10 M:P+2)=%0 ]
590'--- input_lines + parse_grid -> grid ---
600 I=0,80 M:I)=0 @=I+1 I=0
610 ;=I>=9 #=680
620 ?=I+1 "行目: " !=400
630 ;=L=0 #=680
640 !=690 ;=Z #=660
650 "行の長さが9ではないか、構成文字が数字または.ではありません" / #=610
660 J=0,8 X=M:1000+J)-48 M:I*9+J)=X*(X>0) @=J+1
670 I=I+1 #=610
680 ;=I=0 !=500 "サンプル問題を使用します。" /
682 ]
689'--- check line -> Z 1:ok ---
690 Z=L=9 ;=Z=0 ]
692 J=0,8 C=M:1000+J) Z=Z*((C=46)+((C>=48)*(C<=57))) @=J+1 ]
790'--- set r c v ---
800 T=0 J=0 Z=1
810 ;=J>=L #=880
812 C=M:1000+J) ;=(C=32)+(C=9) J=J+1 #=810
814 T=T+1 S=1 D=0 X=0 F=0 ;=(C=45)+(C=43) S=1-((C=45)*2) J=J+1
820 ;=J>=L #=840
822 C=M:1000+J) ;=(C=32)+(C=9) #=840
824 ;=(C<48)+(C>57) F=1
826 ;=(C>=48)*(C<=57) D=D+1 X=X*10+C-48 ;=X>999 X=999
828 J=J+1 #=820
840 ;=(D=0)+F ;=T>1 Z=0
842 X=X*S ;=T=2 R=X
844 ;=T=3 Q=X
846 ;=T=4 V=X
848 #=810
880 ;=T<>4 "使い方: set r c v  (r,c,vは1-9, v=0で空き)" / #=1100
882 R=R-1 Q=Q-1 ;=Z ;=(V>=0)*(V<=9)*(R>=0)*(R<9)*(Q>=0)*(Q<9) M:R*9+Q)=V #=1100
884 "r,cは1-9、vは0-9で指定してください。" / #=1100
990'--- main ---
1000 "=== 数独エディタ＆ソルバ ===" /
1010 "最初の盤面を9行で入力してください。" /
1020 "0 または . は空きマスを表します。例: 530070000" /
1030 "空行のみを入力するとサンプル問題を使います。" /
1040 /
1050 !=600
1060 / G=0 !=300
1100 "コマンド:" /
1110 "  set r c v  : 行r, 列c に値vをセット (r,c, v=1~9, v=0で空き)" /
1120 "  display    : 現在の盤面を表示" /
1130 "  solve      : 現在の盤面を解く" /
1140 "  reset      : 盤面を再入力" /
1150 "  quit       : 終了" /
1160 "> " !=400
1170 ;=(L=0)*E "終了します。" / #=-1
1200 ;=(L=4)*(M:1000)="q")*(M:1001)="u")*(M:1002)="i")*(M:1003)="t") "終了します。" / #=-1
1210 ;=(L=5)*(M:1000)="s")*(M:1001)="o")*(M:1002)="l")*(M:1003)="v")*(M:1004)="e") #=1300
1220 ;=(L=5)*(M:1000)="r")*(M:1001)="e")*(M:1002)="s")*(M:1003)="e")*(M:1004)="t") #=1400
1230 ;=(L>=3)*(M:1000)="s")*(M:1001)="e")*(M:1002)="t") #=800
1240 ;=(L>=7)*(M:1000)="d")*(M:1001)="i")*(M:1002)="s")*(M:1003)="p")*(M:1004)="l")*(M:1005)="a")*(M:1006)="y") G=0 !=300 #=1100
1250 "不明なコマンドです。" / #=1100
1300 !=100 ;=Z "解が見つかりました:" / G=100 !=300 #=1100
1310 "解けませんでした。" / #=1100
1400 "盤面を再入力します。9行を入力してください。" / !=600 #=1100
