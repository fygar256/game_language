#!/usr/bin/env miep
1#BlackJick ver 1.0.1 (fixed) for MIEP (GAME language)
2'memory: deck=0-52 shuffle flags=64-116 computer=128-139 player=144-155 digits=201-209
3'card code: 0=no card 1=Joker 2-53=heart A..spade K
10'--- main ---
100 "**********BlackJick ver 1.0.1 (fixed)**********" /
105 "Random seed:" !=3000 '=D
106 ;=S=0 #=105
110 M=0 X=0 !=1000 !=1200
190'--- play() ---
200 "---------------------------------------------------" /
210 "Pile : " ?=53-X " cards" /
220 "Computer's cards : " !=2000
230 "Player's cards : " H=144 !=1900
240 H=144 !=2300 A=Z/U B=%0 I=1,9 B=B*10 M:200+I)=B/U B=%0 @=I+1
250 W=M:209)>4 C=8 @ M:200+C)=M:200+C)+W W=M:200+C)=10 M:200+C)=M:200+C)-(10*W) C=C-1 @=(C=0)
260 "Expected value of next 1 card is " ?=A+W "." I=1,8 ?=M:200+I) @=I+1 "." /
270 H=144 !=2400 "Have to draw ? " ;=Y "Yes." /
280 ;=Y=0 "No." /
300 "1. Draw a card." / "2. Game." / "3. Quit" / ": " !=3000
310 ;=S=0 #=300
320 ;=D=3 #=-1
330 ;=D>3 #=300
340 ;=D=1 H=144 !=1100
350 !=2500 ;=D<>2 #=200
360 @ !=2500 @=(C=0)
390'--- result() ---
400 !=2100 "====================Result====================" /
410 "Computer : " H=128 !=1900
420 "Player : " H=144 !=1900
430 ;=G=0 "Draw game" /
440 ;=G=1 "Player win" /
450 ;=G=2 "Computer win" /
460 #=-1
990'--- shuffle() ---
1000 I=0,52 M:64+I)=0 @=I+1
1010 I=0,52 @ C='53 @=(M:64+C)=0) M:64+C)=1 M:I)=C+1 @=I+1 ]
1090'--- draw_card(H) V=1:drew 0:not ---
1100 V=0 I=-1 @ I=I+1 @=((I=12)+(M:H+I)=0))
1110 ;=(X<53)*(I<12) M:H+I)=M:X) X=X+1 V=1
1120 ]
1190'--- init_players() ---
1200 I=0,11 M:128+I)=0 M:144+I)=0 @=I+1
1210 H=128 !=1100 !=1100 H=144 !=1100 !=1100 ]
1290'--- number_of_cards(H) -> V ---
1300 V=-1 @ V=V+1 @=((V=12)+(M:H+V)=0)) ]
1390'--- isjoker(H) -> V ---
1400 V=0 I=0,11 V=V+(M:H+I)=1) @=I+1 ]
1490'--- count_cards(H) -> V ---
1500 V=0 J=0,11 K=M:H+J) !=1550 V=V+N @=J+1 ]
1540'--- value of card K -> N (Joker,no card=0 J,Q,K=10) ---
1550 N=0 ;=K<2 ]
1560 N=(K+11)/13 N=%0+1 ;=N>10 N=10
1570 ]
1590'--- eval_cards(H) -> V ---
1600 !=1500 T=V !=1400 ;=V=0 V=T ]
1610 W=21-T ;=W>10 W=10
1620 ;=W<0 W=0
1630 V=T+W ]
1690'--- printcard(K) ---
1700 ;=K=1 "[Joker] " ]
1710 Q=(K+11)/13 R=%0+1 "["
1720 ;=Q=1 "♥"
1730 ;=Q=2 "♦"
1740 ;=Q=3 "♣"
1750 ;=Q=4 "♠"
1760 " "
1770 ;=R=1 "A"
1780 ;=(R>1)*(R<11) ?=R
1790 ;=R=11 "J"
1800 ;=R=12 "Q"
1810 ;=R=13 "K"
1820 "] " ]
1890'--- print_players_line(H) ---
1900 !=1300 L=V P=0,L-1 K=M:H+P) !=1700 @=P+1
1910 ?=L " cards total=" !=1600 ?(3)=V " " ;=V=21 "*BlackJick*"
1920 / ]
1990'--- print_comp() ---
2000 H=128 !=1300 L=V P=1,L "[###] " @=P+1
2010 ?=L " cards." / ]
2090'--- game() -> G 0:draw 1:player win 2:computer win ---
2100 H=128 !=1600 E=V H=144 !=1600 F=V
2110 ;=E=F #=2170
2120 G=0 ;=(E>21)*(F>21) ]
2130 G=1 ;=E>21 ]
2140 G=2 ;=F>21 ]
2150 G=1 ;=E<F ]
2160 G=2 ]
2170 H=128 !=1400 G=2 ;=V ]
2180 H=144 !=1400 G=1 ;=V ]
2190 G=0 ]
2290'--- expected_value_of_next_card(H) = Z/U  (O=own value) ---
2300 !=1500 O=V !=1300 U=53-V !=1400 Z=0
2310 ;=V=0 ;=O<21 Z=21-O ;=Z>10 Z=10
2320 Z=Z+340-O ;=U<1 Z=0 U=1
2330 ]
2390'--- todrawp(H) -> Y  (O+Z/U<=21 <=> O*U+Z<=21*U) ---
2400 Y=0 !=1600 ;=V>20 ]
2410 !=2300 Y=(O*U+Z)<=(21*U) ]
2490'--- computer_turn() -> C ---
2500 C=0 H=128 !=2400 ;=Y=0 ]
2510 !=1300 ;=(X<53)*(V<12) "Computer drew a card." / !=1100 C=1
2520 ]
2990'--- input number -> D  S=0:invalid ---
3000 S=1 D=0 N=0
3010 C=$ ;=C<1 #=-1
3020 ;=C=10 #=3060
3030 ;=C=32 #=3010
3040 ;=(C<48)+(C>57) S=0 #=3010
3050 N=1 ;=D>999 #=3010
3052 D=D*10+C-48
3055 #=3010
3060 ;=N=0 S=0
3070 ]
