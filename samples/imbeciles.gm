#!/usr/bin/env miep
5#Imbeciles Ver 1.0 for GAME language (MIEP) / ANSI terminal
10 M=0 E=1000 F=1100 G=1200 C=1300 B=1400
20 $=27 "[?25l"
99:---- 説明画面 ----
100 $=27 "[0m" $=27 "[2J"
110 Y=2 X=31 !=950 "Imbeciles Ver 1.0"
111 Y=4 X=27 !=950 "Imbeciles means imbeciles."
112 Y=6 X=20 !=950 "Mission : kill all imbeciles to survive!"
113 Y=7 X=19 !=950 "Ｏ -- Imbeciles, chase player step by step."
114 Y=8 X=15 !=950 "＃ -- Rock, die imbeciles and player when touched. "
115 Y=9 X=8 !=950 "＠ -- Player, control for imbeciles to crash to rock and survive!"
116 Y=11 X=20 !=950 "Key control:    　    Tenkey:"
117 Y=12 X=20 !=950 "７  ８  ９            ７　８  ９"
118 Y=13 X=20 !=950 "　↖ ↑  ↗　　　　　　　　↖ ↑  ↗"
119 Y=14 X=20 !=950 "Ｕ← Ｉ→ Ｏ　　　　　　４← ５→ ６"
120 Y=15 X=20 !=950 "　↙ ↓  ↘                ↙ ↓  ↘"
121 Y=16 X=20 !=950 "Ｊ  Ｋ  Ｌ　　　　　　１  ２  ３"
122 Y=17 X=33 !=950 "'q' -- Quit"
123 Y=18 X=15 !=950 " 'i' and '5' move imbeciles and don't move player"
124 Y=19 X=29 !=950 "             Good Luck"
125 Y=20 X=36 !=950 "hit key"
130 K=$ ;=(K=0)+(K="q")+(K="Q") #=850
199:---- ゲーム初期化 ----
200 $=27 "[2J" L=0 R=0 P=20 Q=11
210 A=0,919 M:A)=0 @=A+1
219:岩を配置（プレイヤー位置は避ける）
220 A=1,120
230 X='40 Y='23 ;=(X=P)*(Y=Q) #=230
240 M:Y*40+X)=1 !=900 "＃" @=A+1
249:敵を配置（岩・プレイヤー・他の敵と重ならない）
250 I=0,11
260 X='40 Y='23 ;=M:Y*40+X) #=260
270 ;=(X=P)*(Y=Q) #=260
280 M:Y*40+X)=2 E(I)=X F(I)=Y G:I)=1 !=900 "Ｏ" @=I+1
290 I=0,11 M:F(I)*40+E(I))=0 @=I+1
295 N=12 X=P Y=Q !=900 "＠"
299:---- メインループ：キー入力 ----
300 K=$ ;=K=0 #=850
310 ;=K>64 ;=K<91 K=K+32
315 ;=K="q" #=850
320 D=0 V=0
330 ;=K="7" V=-1 D=-1 #=400
331 ;=K="8" V=-1 #=400
332 ;=K="9" V=-1 D=1 #=400
333 ;=(K="u")+(K="4") D=-1 #=400
334 ;=(K="i")+(K="5") #=400
335 ;=(K="o")+(K="6") D=1 #=400
336 ;=(K="j")+(K="1") V=1 D=-1 #=400
337 ;=(K="k")+(K="2") V=1 #=400
338 ;=(K="l")+(K="3") V=1 D=1 #=400
339 #=300
399:前回の衝突マーク（赤Ｘ）を消す
400 ;=R J=0,R-1 X=C(J) Y=B(J) !=900 "　" @=J+1
409:プレイヤー移動
410 S=P+D H=Q+V
420 ;=(S<0)+(S>39)+(H<0)+(H>22) #=500
430 X=P Y=Q !=900 "　" P=S Q=H X=P Y=Q !=900 "＠"
440 ;=M:Q*40+P) L=1 #=800
450 I=0,11 ;=G:I)*(E(I)=P)*(F(I)=Q) L=1
460 @=I+1 ;=L #=800
499:---- 敵の移動 ----
500 R=0 I=0,11
510 ;=G:I)=0 #=590
520 X=E(I) Y=F(I) !=900 "　"
530 S=X+(P>X)-(P<X) H=Y+(Q>Y)-(Q<Y)
540 ;=(S=P)*(H=Q) L=1 #=800
549:岩に激突：岩と敵が消える
550 ;=M:H*40+S) M:H*40+S)=0 G:I)=0 C(R)=S B(R)=H R=R+1 N=N-1 X=S Y=H !=900 $=27 "[31mＸ" $=27 "[0m" #=590
559:先に動いた敵と衝突：両方消える
560 ;=I=0 #=580
570 J=0,I-1 ;=G:J)*(E(J)=S)*(F(J)=H) G:J)=0 G:I)=0 N=N-2
575 @=J+1 ;=G:I)=0 #=590
580 E(I)=S F(I)=H
590 @=I+1
599:生き残った敵を描画
600 I=0,11 ;=G:I) X=E(I) Y=F(I) !=900 "Ｏ"
610 @=I+1
620 ;=N=0 L=3 #=800
630 #=300
799:---- 勝敗表示 ----
800 ;=L=1 X=P Y=Q !=900 "Ｘ" $=27 "[1;1HYou Lose "
810 ;=L=3 $=27 "[1;1HYou Win! "
820 $=27 "[2;1HTry Again? [y/n]"
830 K=$ ;=K=0 #=850
840 ;=(K="n")+(K="N")+(K="q")+(K="Q") #=850
845 ;=(K="y")+(K="Y") #=100
848 #=830
850 $=27 "[0m" $=27 "[24;1H" $=27 "[?25h" / #=-1
899:---- サブルーチン：盤面座標(X,Y)へカーソル移動 ----
900 $=27 "["?=Y+1 ";"?=X*2+1 "H" ]
949:---- サブルーチン：画面桁(X,Y)へカーソル移動 ----
950 $=27 "["?=Y+1 ";"?=X+1 "H" ]
