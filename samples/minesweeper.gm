#!/usr/bin/env miep
10#==== MINESWEEPER (minesweeper.py の GAME 言語版) ====
11#  4/6/8/2 (←→↑↓ も可) 移動  SPACE 開く  z/m 旗 (＃→Ｍ→？→＃)  q 終了
12#  盤面は 40x23 マス (1マス=全角1文字)。メッセージは 24 行目
13#  V:y*40+x) 周りの地雷数 0-8, 9 は地雷   K:y*40+x) 0 ＃ 1 Ｍ 2 ？ 3 開いた
14#  S(n) reveal 用のスタック  T:g) 表示文字 g の UTF-8 の3バイト目 (g: 0-8 数字 9 ＊ 10 ＃ 11 Ｍ 12 ？ 13 Ｘ)
15#  N 地雷数  U 開いていないマスの数  X,Y カーソル  D 全体を描き直す  R 反転表示
100 V=$1000 K=$1400 T=$1800 S=$2000
110 I=1,8 T:I)=I+$90 @=I+1
120 T:9)=$8A T:10)=$83 T:11)=$AD T:12)=$9F T:13)=$B8
130 "mines (61): " N=? ;=N<1 N=61
140 ;=N>300 "too many mines" / #=-1
150 I=0,919 V:I)=0 K:I)=0 @=I+1
160 !=1200 !=1300 U=920 X=20 Y=11 D=1
170 $=27 "[?1049h" $=27 "[?25l" $=27 "[0m" $=27 "[2J"
1000#==== メインループ ====
1010 ;=D !=3000 D=0
1020 ;=U=N #=2500
1030 R=0 !=3100 !=6000
1040 ;=C<1 #=9000
1050 ;=C="q" #=9000
1060 ;=C="4" ;=X>0 R=1 !=3100 X=X-1
1070 ;=C="6" ;=X<39 R=1 !=3100 X=X+1
1080 ;=C="8" ;=Y>0 R=1 !=3100 Y=Y-1
1090 ;=C="2" ;=Y<22 R=1 !=3100 Y=Y+1
1100 P=Y*40+X
1110 ;=(C="z")+(C="m") ;=K:P)<3 K:P)=K:P)+1/3 K:P)=%0
1120 ;=C=32 ;=V:P)=9 #=5000
1130 ;=C=32 !=4000 D=1
1140 #=1010
1200#==== putmines: N 個の地雷を置く ====
1210 I=1,N
1220   @ P='920 @=(V:P)=0)
1230   V:P)=9
1240 @=I+1 ]
1300#==== calcfield: 地雷でないマスに周りの地雷数を入れる ====
1310 P=0,919
1320   ;=V:P)=0 !=1400
1330 @=P+1 ]
1400 B=P/40 A=%0 Z=0 J=-1,1 I=-1,1
1410   ;=(A+I>=0)*(B+J>=0)*(A+I<40)*(B+J<23) Z=Z+(V:P+I+(J*40))=9)
1420 @=I+1 @=J+1 V:P)=Z ]
2500#==== 勝ち ====
2510 $=27 "[24;1H" $=27 "[7mYou win. hit key" $=27 "[0m" !=6000 #=9000
3000#==== drawscreen: 全マスを反転表示で描く ====
3010 $=27 "[7m" J=0,22 $=27 "[" ?=J+1 ";1H" I=0,39 P=J*40+I !=7000 @=I+1 @=J+1 $=27 "[0m" ]
3100#==== マス (X,Y) を描く。R=1 なら反転表示 ====
3110 $=27 "[" ?=Y+1 ";" ?=X*2+1 "H" ;=R $=27 "[7m"
3120 P=Y*40+X !=7000 $=27 "[0m" ]
4000#==== reveal: P から開いていく (再帰の代わりにスタック S を使う) ====
4010 S(0)=P W=1
4020 @ W=W-1 P=S(W)
4030   ;=K:P)<3 K:P)=3 U=U-1 ;=V:P)=0 !=4100
4040 @=(W=0) ]
4100 B=P/40 A=%0 J=-1,1 I=-1,1
4110   Q=P+I+(J*40) ;=(A+I>=0)*(B+J>=0)*(A+I<40)*(B+J<23)*(K:Q)<3) S(W)=Q W=W+1
4120 @=I+1 @=J+1 ]
5000#==== 負け: printmines してカーソル位置に Ｘ ====
5010 $=27 "[7m" J=0,22 $=27 "[" ?=J+1 ";1H" I=0,39 P=J*40+I !=5100 @=I+1 @=J+1
5020 $=27 "[" ?=Y+1 ";" ?=X*2+1 "H" G=13 !=7020
5030 $=27 "[24;1H" "You lose. hit key" $=27 "[0m" !=6000 #=9000
5100 G=V:P) ;=G<9 #=7020
5110 G=9 ;=K:P)=1 G=11
5120 #=7020
6000#==== getkey: 1キー読んで C に。矢印キーは 8/2/6/4 にする ====
6010 C=$ ;=C<>27 ]
6020 C=$ ;=(C<>91)*(C<>79) ]
6030 C=$ ;=C=65 C=56 ]
6040 ;=C=66 C=50 ]
6050 ;=C=67 C=54 ]
6060 ;=C=68 C=52 ]
6070 ]
7000#==== マス P の表示文字 (retchar) を出す ====
7010 G=K:P)+10 ;=G=13 G=V:P)
7020 ;=G=0 "　" ]
7030 $=$EF $=$BC $=T:G) ]
9000#==== 終了 ====
9010 $=27 "[0m" $=27 "[?25h" $=27 "[?1049l" #=-1
