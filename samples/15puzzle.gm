#!/usr/bin/env miep
10#==== 15パズル (15puzzle.py の GAME 言語版) ====
11#  矢印キー / WASD / HJKL : タイルを空きマスへスライド   r : シャッフルし直す   q : 終了
12#  丸数字 ①〜⑮ (U+2460〜) は UTF-8 で E2 91 A0+n-1 の3バイト
13#  B:i) 盤面 (i=0〜15, 0 は空きマス)  E 空きマスの位置  M 手数
14#  D タイルを動かす向き 1 上 2 下 3 左 4 右  F 動かせるか  S 空きマスと入れ替えるマス
15#  Z 完成なら 1  W 完成メッセージを出すか  C 入力キー
100 B=$1000
110 $=27 "[?1049h" $=27 "[?25l"
120 !=2000
1000#==== メインループ ====
1010 W=0
1020 !=3000 W=0 !=6000
1030 ;=(C="q")+(C="Q")+(C=0) #=9000
1040 ;=(C="r")+(C="R") !=2000 #=1010
1050 ;=(C>64)*(C<91) C=C+32
1060 D=0 ;=(C="w")+(C="k") D=1
1070 ;=(C="s")+(C="j") D=2
1080 ;=(C="a")+(C="h") D=3
1090 ;=(C="d")+(C="l") D=4
1100 !=5000 ;=D*(Z=0) !=4000
1110 !=5000 W=Z #=1020
2000#==== reset: 完成形にしてからシャッフル ====
2010 I=0,14 B:I)=I+1 @=I+1
2020 B:15)=0 E=15 M=0
2100#==== shuffle: 空きマスをランダムに 100 回動かす (必ず解ける配置になる) ====
2110 P=0 H=1,100
2120   O=P-1 A=P/2 ;=%0 O=P+1
2130   @ D='4+1 !=2200 @=(F*(D<>O))
2140   !=2300 P=D
2150 @=H+1
2160 !=5000 ;=Z #=2100
2170 M=0 ]
2200#==== canmove: 向き D に動かせれば F=1, S に入れ替えるマス ====
2210 R=E/4 Q=%0 F=0
2220 ;=D=1 ;=R<3 F=1 S=E+4
2230 ;=D=2 ;=R>0 F=1 S=E-4
2240 ;=D=3 ;=Q<3 F=1 S=E+1
2250 ;=D=4 ;=Q>0 F=1 S=E-1
2260 ]
2300#==== 空きマス E とマス S を入れ替える ====
2310 B:E)=B:S) B:S)=0 E=S ]
3000#==== draw: 画面全体を描く ====
3010 $=27 "[1;1H" $=27 "[2J"
3020 $=27 "[2;4H" $=27 "[1;36m１５パズル" $=27 "[0m"
3030 I=0,15 !=3100 @=I+1
3040 $=27 "[17;4H" $=27 "[33m手数: " ?=M $=27 "[0m"
3050 $=27 "[18;4H矢印/WASD/HJKL:移動  r:シャッフル  q:終了"
3060 ;=W $=27 "[20;4H" $=27 "[1;5;31m完成！おめでとうございます！ (" ?=M "手)" $=27 "[0m  r:もう一度  q:終了"
3070 ]
3100#==== タイル I を描く (幅8桁 x 高さ3行, 横の間隔1桁) ====
3110 V=B:I) R=I/4 Q=%0 X=Q*9+4 Y=R*3+4
3120 G=47 ;=V=(I+1) G=42
3130 ;=V=0 G=40
3140 J=0,2 $=27 "[" ?=Y+J ";" ?=X "H" $=27 "[30;" ?=G "m" .=8 @=J+1
3150 ;=V $=27 "[" ?=Y+1 ";" ?=X+3 "H" $=$E2 $=$91 $=V+$9F
3160 $=27 "[0m" ]
4000#==== move: 動かせれば動かして手数を増やす ====
4010 !=2200 ;=F !=2300 M=M+1
4020 ]
5000#==== solved: 完成形なら Z=1 ====
5010 Z=1 I=0,14 Z=Z*(B:I)=(I+1)) @=I+1 ]
6000#==== read_key: 1キー読んで C に。矢印キーは w/s/d/a、その他のシーケンスは 1 ====
6010 C=$ ;=C<>27 ]
6020 A=$ C=1 ;=(A<>91)*(A<>79) ]
6030 N=0 @ K=$ N=N+1 @=((K>64)*(K<91)+((K>96)*(K<123))+(K=126)+(K=0))
6040 ;=N>1 ]
6050 ;=K=65 C="w"
6060 ;=K=66 C="s"
6070 ;=K=67 C="d"
6080 ;=K=68 C="a"
6090 ]
9000#==== 終了: 画面とカーソルを元に戻す ====
9010 $=27 "[0m" $=27 "[?25h" $=27 "[?1049l" #=-1
