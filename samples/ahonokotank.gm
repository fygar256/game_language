#!/usr/bin/env miep
10#==== AHONOKO TANK (ahonokotank.py の GAME 言語版) ====
11#  キーは /dev/input/eventN から &キーコード で読む (押されていれば 1)
12#  LEFT : e c s f 移動 / z 発射   RIGHT: 8 2 4 6 移動 / 0 発射   q 終了
13#  S 画面バッファ(40x25) U,W 方向の dx,dy Z 方向の順番
14#  L,R タンク: (0)x (1)y (2)向き (3)弾x (4)弾y (5)得点
15#             (6-9)上下左右キー (10)発射キー (11)色 (ボールドで描く) (12)文字 (13)弾の待ちコマ
16#             (14-18)上下左右・発射の別のキー
17#  A 1コマの長さ(ミリ秒)  M 弾が1マス進むコマ数 (大きいほど弾が遅い)
100 S=$4000 U=$5200 W=$5220 Z=$5260 L=$5300 R=$5340 D=$6000 A=60 M=1
110 U(8)=0 W(8)=-1 U(2)=0 W(2)=1 U(4)=-1 W(4)=0 U(6)=1 W(6)=0
120 Z(0)=8 Z(1)=2 Z(2)=4 Z(3)=6
130 L(6)=18 L(7)=46 L(8)=31 L(9)=33 L(10)=44 L(11)=97 L(12)=$80
135 L(14)=18 L(15)=46 L(16)=31 L(17)=33 L(18)=44
140 R(6)=72 R(7)=80 R(8)=75 R(9)=77 R(10)=82 R(11)=97 R(12)=$81
145 R(14)=9 R(15)=3 R(16)=5 R(17)=7 R(18)=11
150 !=1000
160 $=27 "]0;AHONOKO TANK" $=7 $=27 "[?25l"
170 L(5)=0 R(5)=0
180 !=2000
190 ;=L(5)=3 $=27 "[1;35H" $=27 "[97;101m  LEFT  WIN  " !=6000 #=9900
200 ;=R(5)=3 $=27 "[1;35H" $=27 "[97;101m  RIGHT WIN  " !=6000 #=9900
210 #=180
1000#==== マップデータ (1行40マスを10ビットずつ4語に) ====
1010 D(0)=$3FF D(1)=$3FF D(2)=$3FF D(3)=$3FF
1020 D(4)=$200 D(5)=$002 D(6)=$100 D(7)=$001
1030 D(8)=$200 D(9)=$002 D(10)=$100 D(11)=$001
1040 D(12)=$200 D(13)=$002 D(14)=$100 D(15)=$001
1050 D(16)=$200 D(17)=$000 D(18)=$000 D(19)=$001
1060 D(20)=$201 D(21)=$3F0 D(22)=$03F D(23)=$201
1070 D(24)=$261 D(25)=$000 D(26)=$000 D(27)=$219
1080 D(28)=$221 D(29)=$000 D(30)=$000 D(31)=$211
1090 D(32)=$221 D(33)=$000 D(34)=$000 D(35)=$211
1100 D(36)=$221 D(37)=$002 D(38)=$100 D(39)=$211
1110 D(40)=$220 D(41)=$01E D(42)=$1E0 D(43)=$011
1120 D(44)=$220 D(45)=$000 D(46)=$000 D(47)=$011
1130 D(48)=$220 D(49)=$000 D(50)=$000 D(51)=$011
1140 D(52)=$220 D(53)=$000 D(54)=$000 D(55)=$011
1150 D(56)=$220 D(57)=$01E D(58)=$1E0 D(59)=$011
1160 D(60)=$221 D(61)=$002 D(62)=$100 D(63)=$211
1170 D(64)=$221 D(65)=$000 D(66)=$000 D(67)=$211
1180 D(68)=$221 D(69)=$000 D(70)=$000 D(71)=$211
1190 D(72)=$261 D(73)=$000 D(74)=$000 D(75)=$219
1200 D(76)=$201 D(77)=$3F0 D(78)=$03F D(79)=$201
1210 D(80)=$200 D(81)=$000 D(82)=$000 D(83)=$001
1220 D(84)=$200 D(85)=$002 D(86)=$100 D(87)=$001
1230 D(88)=$200 D(89)=$002 D(90)=$100 D(91)=$001
1240 D(92)=$200 D(93)=$002 D(94)=$100 D(95)=$001
1250 D(96)=$3FF D(97)=$3FF D(98)=$3FF D(99)=$3FF
1260 ]
2000#==== match ====
2010 !=3000 !=3100 !=3200
2020 *WT A
2030 ;=&16 #=9900
2040 V=L !=4000 ;=H #=2100
2050 V=R !=4000 ;=H #=2150
2060 T=R !=7000 T=L !=7000 T=R !=7500 T=L !=7500
2070 #=2020
2100 $=27 "[1;35H" $=27 "[92;104m Right Point " R(5)=R(5)+1 !=3100 V=L !=3300
2110 ;=R(5)<=2 !=6000
2120 ]
2150 $=27 "[1;35H" $=27 "[92;104m Left  Point " L(5)=L(5)+1 !=3100 V=R !=3300
2160 ;=L(5)<=2 !=6000
2170 ]
3000#==== ahotan_map ====
3010 I=0,999 S:I)=0 @=I+1
3020 $=27 "[40m" $=27 "[2J"
3030 Y=0,24 $=27 "[" ?=Y+1 ";1H"
3040 G=0,3 B=D(Y*4+G) P=512
3050 J=0,9
3060   C=B>=P B=B-(C*P) P=P/2
3070   ;=C S:Y*40+(G*10)+J)=$90 $=27 "[102m  " $=27 "[40m"
3080   ;=C=0 "  "
3090 @=J+1 @=G+1 @=Y+1 ]
3100#==== dispscores ====
3110 $=27 "[1;16H" $=27 "[30;102mLeft:" $=L(5)+48
3120 $=27 "[1;62HRight:" $=R(5)+48 $=27 "[40m" ]
3200#==== place_tanks ====
3210 L(0)=2 L(1)=12 L(2)=6 L(3)=0
3220 R(0)=37 R(1)=12 R(2)=4 R(3)=0 ]
3300#==== disp_hit (V のタンク位置に *) ====
3310 $=27 "[91m" X=V(0) Y=V(1) C="*" !=8100 ]
4000#==== V のタンクに弾が当たったら H=1 ====
4010 H=(L(3)=V(0))*(L(4)=V(1))
4020 H=H+((R(3)=V(0))*(R(4)=V(1))) ]
6000#==== keywait ====
6010 $=27 "[25;35H" $=27 "[94;102mHit ENTER Key"
6020 C=&28+&96
6030 @
6040   *WT 20
6050   ;=&16 #=9900
6060 @=(&28+&96)
6070 ]
7000#==== タンク T (righttank/lefttank) ====
7010 X=T(0) Y=T(1) C=0 !=8100
7020 X=X+U(T(2)) Y=Y+W(T(2)) C=0 !=8100
7030 I=0,3
7040   N=Z(I) !=7100
7050 @=I+1
7060 ;=&T(10)+&T(18) ;=T(3)=0 T(3)=T(0)+U(T(2)) T(4)=T(1)+W(T(2)) T(13)=0
7070 $=27 "[1;" ?=T(11) "m" X=T(0) Y=T(1) C=T(12) !=8100
7080 X=X+U(T(2)) Y=Y+W(T(2)) C=$82+((T(2)=4)+(T(2)=6)) !=8100 $=27 "[22m" ]
7100#==== tanksub (向き N, キー T(6+I) か T(14+I)) ====
7110 ;=&T(6+I)+&T(14+I)=0 ]
7120 E=U(N) F=W(N) X=T(0)+E Y=T(1)+F
7130 ;=S:Y*40+X)<>0 ]
7140 ;=T(2)<>N T(2)=N ]
7150 ;=S:Y+F*40+X+E)<>0 ]
7160 T(0)=X T(1)=Y ]
7500#==== 弾 T (rightbullet/leftbullet) ====
7510 ;=T(3)=0 ]
7515 ;=T(13)>0 T(13)=T(13)-1 ]
7520 T(13)=M-1 E=U(T(2)) F=W(T(2)) X=T(3) Y=T(4) C=0 !=8100
7530 X=X+E Y=Y+F C=S:Y*40+X)
7540 ;=C<>0 ;=(C<$80)+(C>$81) T(3)=0 ]
7550 T(3)=X T(4)=Y $=27 "[1;" ?=T(11) "m" C=$82+((T(2)=4)+(T(2)=6)) !=8100 $=27 "[22m" ]
8000#==== putchar: (X,Y) に文字 C (1マス=2桁) ====
8100 S:Y*40+X)=C $=27 "[" ?=Y+1 ";" ?=X*2+1 "H"
8110 ;=C=0 "  " ]
8120 ;=C="*" "＊" ]
8130 ;=C=$82 "｜" ]
8140 ;=C=$83 "－" ]
8150 "  " $=27 "[" ?=Y+1 ";" ?=X*2+1 "H"
8160 ;=C=$80 "◯" ]
8170 "●" ]
9900#==== 終了 ====
9910 $=27 "[0m" $=27 "[2J" $=27 "[H" $=27 "[?25h"
9920 *QU
