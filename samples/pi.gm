#!/usr/bin/env miep
10*** pi.gm 円周率をマチンの公式で求める
20*** pi = 16*atan(1/5) - 4*atan(1/239)
30*** atan(1/m) = 1/m - 1/(3m^3) + 1/(5m^5) - ...
40*** P:0) が整数部、P:1)..P:L) が小数部の10進1桁ずつのバイト配列 (L = 桁数+6 桁の保護桁付き)。
50*** T は 1/m^k の項、W は T/k の一時領域。Z は T の最初の0でない桁。
100 "Digits ? " D=? L=D+6 P=0 T=L+1 W=T+L+1
110 I=0,L P:I)=0 @=I+1
120 E=16 M=5 S=1 !=1000
130 E=4 M=239 S=-1 !=1000
140 "pi = " ?=P:0) "."
150 I=1,D ?=P:I) @=I+1
160 /
170 #=-1
1000*** P = P + S*E*atan(1/M)
1010 I=0,L T:I)=0 @=I+1
1020 T:0)=E Z=0 V=M !=2000
1030 K=1
1040 @
1050   !=2100
1060   ;=S>0 !=2200
1070   ;=S<0 !=2300
1080   S=-S K=K+2
1090   V=M !=2000 !=2000
1100   ;=Z<=L ;=T:Z)=0 Z=Z+1 #=1100
1110 @=(Z>L)
1120 ]
2000*** T = T / V
2010 R=0 I=Z,L X=R*10+T:I) T:I)=X/V R=% @=I+1
2020 ]
2100*** W = T / K
2110 R=0 I=0,L X=R*10+T:I) W:I)=X/K R=% @=I+1
2120 ]
2200*** P = P + W
2210 C=0 I=L
2220 @
2230   X=P:I)+W:I)+C C=X/10 P:I)=%
2240   I=I-1
2250 @=(I<0)
2260 ]
2300*** P = P - W
2310 C=0 I=L
2320 @
2330   X=P:I)-W:I)-C C=0
2340   ;=X<0 X=X+10 C=1
2350   P:I)=X I=I-1
2360 @=(I<0)
2370 ]
